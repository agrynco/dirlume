{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dirlume",
  "version": "0.1.0",
  "identifier": "io.github.agrynco.dirlume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dirlume",
        "visible": false,
        "width": 1240,
        "height": 760,
        "minWidth": 760,
        "minHeight": 460,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1N0E4QUMxNzI2MkUxNDAKUldSQTRXSnl3WXA2ZFZjZHljYWtxZWl6c3VKSTF2amVzYkRCYTdUbXZPZ0QwNVNLRFc4TDNuUDMK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "Two-pane desktop file manager",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "resources": {
      "../src/assets/fonts/GoMono-LICENSE.txt": "licenses/GoMono-LICENSE.txt",
      "../src/assets/fonts/Nerd-Fonts-LICENSE.txt": "licenses/Nerd-Fonts-LICENSE.txt",
      "../src/assets/fonts/GoMono-NOTICE.txt": "licenses/GoMono-NOTICE.txt",
      "src/completion/KS-Completion-LICENSE.txt": "licenses/KS-Completion-LICENSE.txt",
      "src/completion/NOTICE.txt": "licenses/Command-Completion-NOTICE.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
