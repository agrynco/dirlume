{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dirlume",
  "version": "0.1.0",
  "identifier": "com.dirlume.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dirlume",
        "width": 1240,
        "height": 760,
        "minWidth": 760,
        "minHeight": 460,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "Two-pane desktop file manager",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
